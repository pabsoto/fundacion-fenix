NODE_ENV=development
PORT=3000
# Swagger se habilita por defecto fuera de producción. En producción sólo se
# publica cuando esta variable vale exactamente "true".
# SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://usuario:TU_PASSWORD@host:5432/postgres
# Ruta local opcional al certificado CA de Supabase; no guardes el certificado en Git.
DATABASE_CA_CERT_PATH=C:/ruta/segura/prod-supabase.cer

# Supabase Storage (sólo backend). Nunca copies la service role key al frontend.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_DE_SERVIDOR
SUPABASE_STORAGE_BUCKET=fenix-donaciones

# Frontend administrativo al que se redirige tras autenticarse con Google.
# Su origen debe estar incluido en CORS_ALLOWED_ORIGINS.
AUTH_REDIRECT_URL=http://localhost:5173/admin

# Cookie de sesión administrativa (HttpOnly, sin tokens de Google dentro).
# SESSION_COOKIE_NAME=fenix_session
# SESSION_COOKIE_PATH=/api
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_SAMESITE=lax
# Secure es true por defecto en producción. En desarrollo puede fijarse a false
# de forma explícita para trabajar con http://localhost.
# SESSION_COOKIE_SECURE=false
# Caducidad por inactividad (60-86400 s), caducidad máxima absoluta (hasta
# 604800 s) e intervalo de renovación del identificador de sesión (0-3600 s).
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# SESSION_ROTATION_INTERVAL_SECONDS=300

# Son ficticias: sustitúyelas por las reales únicamente en tu archivo .env local.
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET

GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Secreto aleatorio de al menos 32 caracteres para firmar la cookie de la
# transacción OAuth. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GOOGLE_OAUTH_STATE_SECRET=TU_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
# Opcionales: duración de la transacción OAuth (60-900 segundos) y metadatos OIDC.
# GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600
# GOOGLE_OAUTH_ISSUER=https://accounts.google.com
# GOOGLE_OAUTH_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Procedimiento aislado de vinculación inicial de identidad Google.
# Opcional. La CLI reutiliza GOOGLE_CALLBACK_URL por defecto. Define esta
# variable sólo si el cliente OAuth tiene otro callback loopback autorizado.
# GOOGLE_LINK_CALLBACK_URL=http://127.0.0.1:3005/callback
# GOOGLE_LINK_AUTHORIZATION_TOKEN=TU_SECRETO_DE_AUTORIZACION
# GOOGLE_LINK_CLI_PORT=3005
